
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USER PROFILES
    match /users/{userId} {
      allow read, create, update, delete:
        if request.auth != null &&
        request.auth.uid == userId;
    }

    // USERNAMES
    match /usernames/{username} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;

      allow update, delete: if false;
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == "pending";

      allow read: if request.auth != null &&
        (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == "pending" &&
        request.resource.data.status in ["accepted", "rejected"] &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["status", "updatedAt"]);

      allow delete: if request.auth != null &&
        (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    // FRIENDSHIPS
    match /friendships/{friendshipId} {
      allow get: if request.auth != null &&
        (
          !exists(
            /databases/$(database)/documents/friendships/$(friendshipId)
          ) ||
          request.auth.uid in resource.data.members
        );

      allow list: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.requestId is string &&
        existsAfter(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
        ) &&
        getAfter(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
        ).data.status == "accepted" &&
        getAfter(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
        ).data.toUid == request.auth.uid &&
        request.resource.data.members.hasAll([
          getAfter(
            /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
          ).data.fromUid,
          getAfter(
            /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
          ).data.toUid
        ]);

      allow update, delete: if false;
    }

    // PRIVATE FRIEND CHAT MESSAGES
    match /chats/{conversationId}/messages/{messageId} {

      function isConversationMember() {
        return request.auth != null &&
          exists(
            /databases/$(database)/documents/friendships/$(conversationId)
          ) &&
          request.auth.uid in get(
            /databases/$(database)/documents/friendships/$(conversationId)
          ).data.members;
      }

      allow read: if isConversationMember();

      allow create: if isConversationMember() &&
        request.resource.data.keys().hasAll([
          "text",
          "senderId",
          "senderName",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "text",
          "senderId",
          "senderName",
          "createdAt"
        ]) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderName is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }
  }
}
